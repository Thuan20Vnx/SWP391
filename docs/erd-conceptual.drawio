        <mxCell id="c_n1" value="ClubMembership carries its own attributes (status, requestedAt, joinedAt, leftAt) and ClubFollow carries followedAt / unfollowedAt — in Chen terms these are attributes ON the relationship, which is why both need a physical collection." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
