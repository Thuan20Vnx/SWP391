        <mxCell id="c_n1" value="REGISTERS holds status, registeredAt, checkedInAt, attendanceLog and the amount actually paid — a relationship this heavy is always a physical collection." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="100" y="1290" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c_n2" value="MAY SCAN FOR is QrScannerGrant: it grants a user the right to GENERATE station QR codes for an event, not to scan other people’s tickets." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
