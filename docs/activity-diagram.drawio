          <mxGeometry x="200" y="290" width="720" height="8" as="geometry" />
        </mxCell>
        <mxCell id="a_p1" value="Load approved events
(first 30 used)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="170" y="330" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_p2" value="Load public announcements
(latest 20) — .catch → []" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="450" y="330" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_p3" value="Fetch current weather
— .catch → null" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="730" y="330" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_join" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="200" y="425" width="720" height="8" as="geometry" />
        </mxCell>
        <mxCell id="a_a2" value="Build data block + system prompt" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="465" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_a3" value="chatJson — try providers in order:
GROQ → GEMINI → MIMO" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="545" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_d1" value="Any provider returned
valid JSON?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="445" y="635" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a4" value="Map eventRefs → events,
attach announcements + action" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="770" width="300" height="56" as="geometry" />
