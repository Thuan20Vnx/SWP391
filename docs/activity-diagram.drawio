<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="ac-login" name="Login + Lockout">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1460" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_t" value="Login — Guards and Progressive Lockout" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a_s" value="Every guard runs before the password is even compared. The bcrypt call happens even when no account exists, so response time never reveals which identifiers are real." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a_start" value="" style="ellipse;fillColor=#1A1A1A;strokeColor=#1A1A1A;html=1;" vertex="1" parent="1">
          <mxGeometry x="418" y="150" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_a1" value="POST /auth/login
{ identifier, password }" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="200" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_d1" value="IP under the
rate-limit window?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="315" y="285" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a2" value="Look up User by email or username" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="410" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_a3" value="lockKey = user.email if found,
otherwise the raw identifier" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="480" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_d2" value="Email locked or
temporarily locked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="315" y="565" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_d3" value="Account has a
passwordHash?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="315" y="690" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a4" value="bcrypt.compare(password, hash ?? DUMMY_HASH)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="815" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="a_d4" value="User exists and
hash matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="315" y="905" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a6" value="clearLoginLockout(lockKey)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="1030" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_a7" value="syncAndPersistUserProfile(user)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
