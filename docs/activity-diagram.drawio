        <mxCell id="a_e1_e" value="" style="ellipse;shape=endState;fillColor=#1A1A1A;strokeColor=#1A1A1A;html=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="668" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_n1" value="Announcements and weather each carry their own .catch, so only the events lookup can fail the whole call. Weather missing simply becomes a &quot;not available&quot; line in the prompt." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1030" y="200" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a_n2" value="The provider chain is GROQ → GEMINI → MIMO (aiProvider.service.js). The fallback reply below is only reached when all three are unconfigured or failing." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1030" y="380" width="300" height="140" as="geometry" />
