        </mxCell>
        <mxCell id="a_n1" value="A free ticket calls occupySlot, which bumps registeredCount. A paid checkout calls reserveSlot, which bumps reservedCount and is released again when the payment expires or is cancelled. Both go through the same claim-sweep-retry wrapper." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="980" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="a_n2" value="The retry runs only when the sweep actually freed something, so a genuinely full event fails fast instead of spinning." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="700" y="180" width="340" height="110" as="geometry" />
        </mxCell>
