  <diagram id="ac-qr" name="QR Check-in">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1580" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_t" value="QR Attendance — Check-in and Check-out" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a_s" value="The station QR belongs to the event, not to the student: the organiser displays it and each attendee scans it. The backend resolves the registration from the scanning user’s own session." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1240" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a_start" value="" style="ellipse;fillColor=#1A1A1A;strokeColor=#1A1A1A;html=1;" vertex="1" parent="1">
          <mxGeometry x="438" y="150" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_a1" value="Organiser with manage rights generates a station QR
(token + expiresAt + attendanceCode) for checkin or checkout" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="195" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_a2" value="Student scans the station QR, or types the code" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="285" width="340" height="48" as="geometry" />
