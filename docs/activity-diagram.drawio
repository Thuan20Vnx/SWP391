        <mxCell id="a_d4" value="Ticket cancelled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="815" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a4" value="sessionKey = today’s local date;
look for that session in attendanceLog" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
