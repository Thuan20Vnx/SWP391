        </mxCell>
        <mxCell id="a_n1" value="sessionKey is the local calendar date, so a multi-day event keeps one check-in/check-out pair per day in attendanceLog." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="a_n2" value="QrScannerGrant controls who may GENERATE a station QR for an event — it is not a permission to scan other people’s tickets." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
