  <diagram id="ac-chat" name="AI Chatbot RAG">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="940" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_t" value="AI Chatbot — Retrieval and Provider Fallback" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a_s" value="The three retrievals run concurrently under one Promise.all. Two of them swallow their own errors, so a failed lookup degrades the answer instead of failing the request." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1200" height="32" as="geometry" />
        </mxCell>
