          <mxGeometry x="1040" y="1213" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_f1" value="recordFailedLogin:
failedAttempts += 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1120" y="863" width="300" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_d5" value="failedAttempts &gt;=
maxAttempts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1155" y="940" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_d6" value="penaltyStage?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1155" y="1075" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_t1" value="stage 0 → lock 30 s, stage = 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeWidth=2.5;" vertex="1" parent="1">
