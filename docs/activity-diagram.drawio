          <mxGeometry x="1830" y="973" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_n1" value="The lock counter is keyed on the account’s real email even when the user signed in with a username — otherwise alternating between the two would double the allowed attempts." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a_n2" value="DUMMY_PASSWORD_HASH is a real bcrypt hash. Comparing against it when no user is found keeps the timing identical, but the null check is still explicit — the code never relies on the dummy hash failing to match." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1260" width="300" height="160" as="geometry" />
        </mxCell>
