          <mxGeometry x="548" y="860" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_e1" value="Return the canned fallback reply" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeWidth=2.5;" vertex="1" parent="1">
