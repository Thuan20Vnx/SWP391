  <diagram id="ac-seat" name="Concurrent Seat Claim">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="a_t" value="Claiming a Seat Under Concurrent Load" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a_s" value="The capacity test and the counter bump are one findOneAndUpdate, so MongoDB serialises competing requests. If it fails, expired holds are swept and the claim is retried exactly once." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="1240" height="32" as="geometry" />
        </mxCell>
        <mxCell id="a_start" value="" style="ellipse;fillColor=#1A1A1A;strokeColor=#1A1A1A;html=1;" vertex="1" parent="1">
          <mxGeometry x="438" y="150" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_a1" value="claim(): findOneAndUpdate(
{ _id, capacity &gt; registeredCount + reservedCount },
$inc the counter, returnDocument: after )" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="195" width="340" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a_d1" value="Document returned?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="300" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a_a2" value="sweepExpiredReservations(eventId)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="425" width="340" height="48" as="geometry" />
        </mxCell>
        <mxCell id="a_a3" value="For every pending Payment with slotReserved
and expiresAt &lt;= now:
closePendingAndReleaseSlot(id, &quot;expired&quot;)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="505" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a_d2" value="Did the sweep release
at least one seat?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="600" width="230" height="90" as="geometry" />
        </mxCell>
