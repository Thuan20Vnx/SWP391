          <mxGeometry x="548" y="150" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="a_a1" value="Receive chat history + page context" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="200" width="300" height="48" as="geometry" />
        </mxCell>
