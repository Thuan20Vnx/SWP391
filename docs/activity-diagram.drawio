        <mxCell id="a_d3" value="Registration found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="335" y="690" width="230" height="90" as="geometry" />
