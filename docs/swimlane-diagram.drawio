        <mxCell id="w_n1" value="ICPDP approving a CLUB proposal writes pending_admin onto BOTH the EventProposal and the linked Event, then notifies Admin. A non-club proposal goes to pending_ctsv instead — that branch is on the EventProposal state page." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1400" y="200" width="280" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w_n2" value="The approve endpoint is guarded by requireCtsvApprove, but it additionally refuses a club proposal unless the caller is admin — so CTSV cannot sign off a club event." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1400" y="420" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="w_n3" value="status = live is set by an explicit CTSV action, not by a scheduler. Nothing in BE/src flips approved to live automatically." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
