          <mxGeometry x="778" y="1560" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="w_n1" value="The claim is one findOneAndUpdate filtered on {status: pending}, read with returnDocument: before. Whoever flips it first owns the seat, so a replayed webhook cannot double-book." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1300" y="200" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="w_n2" value="A free ticket skips the SePay lane entirely: EventRegistration is created directly at registered." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1300" y="400" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="w_n3" value="expireMinutes comes from SystemSettings.payment (default 15). A sweep flips stale pending payments to expired and hands the seat back to capacity." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1300" y="530" width="280" height="140" as="geometry" />
        </mxCell>
        <mxCell id="w_n4" value="Attendance is SELF-SCAN. performSelfScan resolves the registration from the scanning user’s own session, so the person scanning is the person marked present. QrScannerGrant is the right to GENERATE a station QR for an event, not to scan other people’s tickets." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1300" y="700" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="w_n5" value="The confirmation email carries the order code and amount — there is no ticket QR attached. Check-in uses the event’s station QR instead." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
