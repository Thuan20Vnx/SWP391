        <mxCell id="s_n2" value="statusBeforeModeration is captured immediately before the request is raised (captureStatusBeforeModeration)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
