        <mxCell id="s_cf1" value="requestType = delete
⇒ Club.status = inactive   (soft retire, never removed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BBBBBB;strokeWidth=1;fontSize=10;fontColor=#555555;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="650" width="380" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s_n1" value="Each request stores two embedded documents: snapshot{} freezes the record as it looked when the request was raised, payload{} holds the proposed values. Approval copies payload onto the live record field by field — an absent field is left alone rather than blanked." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1200" y="160" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="s_n2" value="Neither delete actually removes anything. A club is retired by flipping status to inactive; an event is flagged isDeleted + isHidden and forced to ended. Both records stay queryable." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1200" y="540" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="s_n3" value="Rejection only writes status and adminNote — the target document is never touched." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1200" y="700" width="300" height="60" as="geometry" />
        </mxCell>
