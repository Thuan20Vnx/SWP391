        <mxCell id="s_n1" value="A school-level event skips the ICPDP tier: it is created at pending and submitted straight to pending_admin. A club event is created at pending_icpdp and, once ICPDP approves, jumps to pending_admin — pending_ctsv belongs to EventProposal, never to Event." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1400" y="648" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="s_n3" value="eventState is a parallel field: active | postponed | expired. Approving &quot;postpone&quot; changes eventState only — status is left untouched. status = live is an explicit CTSV action; nothing schedules it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="560" height="60" as="geometry" />
