PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/FEventsDB?retryWrites=true&w=majority

# Tạo admin: node seed-admin.js [email] [password] [fullname]
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FULLNAME=

# JWT (required in production)
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# SMTP — BẮT BUỘC để gửi email OTP / thông báo
#
# --- Gmail ---
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password
#
# --- Brevo (https://www.brevo.com) ---
# EMAIL_USER=email-đăng-ký-brevo@của-bạn.com
# EMAIL_PASS=xsmtpsib-...   # SMTP key: Brevo → Settings → SMTP & API → Generate
# Sau đó trong Admin → Kiểm soát hệ thống → Email đặt:
#   Host: smtp-relay.brevo.com | Port: 587 | Mã hóa: TLS
#   Email gửi đi: noreply@domain-đã-xác-minh-trên-brevo
EMAIL_USER=
EMAIL_PASS=

# Mật khẩu mặc định khi admin tạo tài khoản mới (mặc định Fpt@2026)
ADMIN_DEFAULT_USER_PASSWORD=Fpt@2026

# URL frontend
APP_URL=http://localhost:5173

# Google OAuth (optional — mock mode if unset)
# Bật Google Calendar API và thêm scope calendar.events trên OAuth consent screen
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/auth/google/calendar/callback

# Gemini API — dùng cho chatbot trợ lý ảo (lấy key tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenWeatherMap — dùng cho widget thời tiết (lấy key tại https://openweathermap.org/api)
OPENWEATHER_API_KEY=
