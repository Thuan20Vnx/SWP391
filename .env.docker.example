# Copy to .env in project root:  cp .env.docker.example .env
# docker compose reads variables from .env automatically.

# Public URL users open in the browser (must match VITE_API_BASE for OAuth)
APP_URL=http://localhost
CLIENT_ORIGIN=http://localhost
VITE_API_BASE=http://localhost

# Host port for the web UI (default 80)
FRONTEND_PORT=80

# Backend secrets
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_USER_PASSWORD=Fpt@2026

# Gmail SMTP (optional — required for real email)
EMAIL_USER=
EMAIL_PASS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost/api/auth/google/calendar/callback

# Use external MongoDB Atlas instead of the bundled mongo container:
# 1. Comment out the `mongo` service and `depends_on` in docker-compose.yml
# 2. Set MONGO_URI on the backend service, e.g.:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/FEventsDB
